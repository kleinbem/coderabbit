#!/usr/bin/env bash
# cr-full-review: a CodeRabbit review of whole files instead of a diff.
#
# Opens a throwaway PR whose base is an empty tree, so every line of the chosen
# paths shows as new, then collects the findings and deletes the PR's branches.
#
#   cr-full-review open [-R owner/repo] [-r rev] [-n name] [--dry-run] [path...]
#   cr-full-review wait <pr-url>        until CodeRabbit has reviewed (asks once after 10 min)
#   cr-full-review findings <pr-url>    save review bodies and threads to ~/.cache/cr-full-review/
#   cr-full-review close <pr-url>       save findings, close the PR, delete both branches
#
# Run `open` inside the repo (git or jj); without paths it reviews the whole tree at rev.
# The PR goes to the remote whose URL names owner/repo (default: origin's), so a fork
# works for upstreams without CodeRabbit.
set -euo pipefail

LABEL=cr-review
BOT=coderabbitai
CACHE=${XDG_CACHE_HOME:-$HOME/.cache}/cr-full-review

die() { echo "cr-full-review: $*" >&2; exit 1; }
usage() { sed -n '2,13s/^# \{0,1\}//p' "$0"; exit "${1:-0}"; }

# owner/repo and number from a PR URL.
parse_pr() {
  [[ $1 =~ github\.com/([^/]+/[^/]+)/pull/([0-9]+) ]] || die "not a PR URL: $1"
  REPO=${BASH_REMATCH[1]} PR=${BASH_REMATCH[2]}
}

repo_of_url() { sed -E 's#^(git@github\.com:|https://github\.com/)##; s#\.git$##' <<<"$1"; }

cmd_open() {
  local repo="" rev="" name="" dry=0 paths=()
  while (($#)); do
    case $1 in
      -R) repo=$2; shift 2 ;;
      -r) rev=$2; shift 2 ;;
      -n) name=$2; shift 2 ;;
      --dry-run) dry=1; shift ;;
      -h|--help) usage ;;
      --) shift; paths+=("$@"); break ;;
      -*) die "unknown option $1" ;;
      *) paths+=("$1"); shift ;;
    esac
  done

  # In jj, default to @ (git's HEAD is @-); a workspace may have no .git of its own.
  if command -v jj >/dev/null && jj root >/dev/null 2>&1; then
    : "${rev:=$(jj log --no-graph -r @ -T commit_id)}"
    git rev-parse --git-dir >/dev/null 2>&1 || { GIT_DIR=$(jj git root); export GIT_DIR; }
  fi
  git rev-parse --git-dir >/dev/null 2>&1 || die "not in a git or jj repo"
  : "${rev:=HEAD}"
  rev=$(git rev-parse --verify "$rev^{commit}")

  local remote
  if [[ -z $repo ]]; then
    remote=origin
    repo=$(repo_of_url "$(git remote get-url origin)")
  else
    remote=""
    for r in $(git remote); do
      [[ $(repo_of_url "$(git remote get-url "$r")") == "$repo" ]] && { remote=$r; break; }
    done
    [[ -n $remote ]] || die "no remote points at $repo"
  fi

  local tree
  if ((${#paths[@]})); then
    local idx; idx=$(mktemp); rm -f "$idx"
    GIT_INDEX_FILE=$idx git read-tree --empty
    git ls-tree -r --full-tree "$rev" -- "${paths[@]}" | GIT_INDEX_FILE=$idx git update-index --index-info
    tree=$(GIT_INDEX_FILE=$idx git write-tree)
    rm -f "$idx"
  else
    tree=$(git rev-parse "$rev^{tree}")
  fi
  local empty; empty=$(git mktree </dev/null)
  [[ $tree != "$empty" ]] || die "no files match ${paths[*]} at $rev"
  local files; files=$(git ls-tree -r --name-only "$tree" | wc -l)

  : "${name:=$(basename "${paths[0]:-${repo#*/}}")}"
  name=$(tr -c 'A-Za-z0-9._-' '-' <<<"$name" | sed 's/-*$//')
  local branch
  branch="review/$name-$(date +%Y%m%d-%H%M%S)"

  # Throwaway commits: unsigned on purpose, no review branch is ever merged.
  local base head
  base=$(git commit-tree --no-gpg-sign "$empty" -m "review base: empty tree")
  head=$(git commit-tree --no-gpg-sign -p "$base" "$tree" -m "review: $name at ${rev:0:12}")

  echo "repo:   $repo (remote $remote)"
  echo "source: ${rev:0:12}, $files file(s)${paths[*]:+: ${paths[*]}}"
  echo "branch: $branch/{base,all}"
  ((dry)) && { echo "dry run: nothing pushed"; return; }

  git push --no-verify "$remote" "$base:refs/heads/$branch/base" "$head:refs/heads/$branch/all" >/dev/null
  gh label create "$LABEL" -R "$repo" --color 5319e7 --description "Request a CodeRabbit review" >/dev/null 2>&1 || true
  gh pr create -R "$repo" --base "$branch/base" --head "$branch/all" --label "$LABEL" \
    --title "[review only] $name full review, do not merge" \
    --body "Full-code CodeRabbit review of ${paths[*]:-the whole tree} at \`$rev\` ($files files). The base branch is an empty tree, so every line shows as new.

**Do not merge.** Findings get fixed in normal PRs; this PR and both branches are deleted afterwards (\`cr-full-review close\`)."
}

# Has CodeRabbit finished a review (or said it won't)?
reviewed() {
  local n
  n=$(gh api "repos/$REPO/pulls/$PR/reviews" --paginate --jq "[.[] | select(.user.login | startswith(\"$BOT\"))] | length")
  ((n > 0)) && return 0
  gh api "repos/$REPO/issues/$PR/comments" --paginate --jq ".[] | select(.user.login | startswith(\"$BOT\")) | .body" |
    grep -qiE 'review(s)? (completed|paused|failed)|rate limit|No actionable comments'
}

cmd_wait() {
  parse_pr "${1:?PR URL}"
  local start=$SECONDS asked=0
  until reviewed; do
    if ((!asked && SECONDS - start > 600)); then
      gh pr comment "$PR" -R "$REPO" --body "@$BOT review" >/dev/null; asked=1
      echo "no review after 10 min: asked once"
    fi
    ((SECONDS - start < 2700)) || die "no review after 45 min"
    sleep 60
  done
  echo "reviewed: $(gh pr view "$PR" -R "$REPO" --json url --jq .url)"
}

cmd_findings() {
  parse_pr "${1:?PR URL}"
  mkdir -p "$CACHE"
  local out="$CACHE/${REPO/\//-}-$PR.md" owner=${REPO%/*} name=${REPO#*/}
  {
    echo "# CodeRabbit findings: $REPO#$PR"
    echo
    gh api "repos/$REPO/pulls/$PR/reviews" --paginate \
      --jq ".[] | select(.user.login | startswith(\"$BOT\")) | \"## Review (\(.state))\n\n\(.body)\n\""
    local after="" page
    while :; do
      # shellcheck disable=SC2016 # GraphQL variables, not shell ones
      page=$(gh api graphql -F owner="$owner" -F name="$name" -F pr="$PR" ${after:+-F after="$after"} -f query='
        query($owner:String!,$name:String!,$pr:Int!,$after:String){repository(owner:$owner,name:$name){
          pullRequest(number:$pr){reviewThreads(first:100,after:$after){pageInfo{hasNextPage endCursor}
            nodes{path line comments(first:1){nodes{body}}}}}}}')
      jq -r '.data.repository.pullRequest.reviewThreads.nodes[] |
        "## \(.path):\(.line // "file")\n\n\(.comments.nodes[0].body)\n"' <<<"$page"
      [[ $(jq -r '.data.repository.pullRequest.reviewThreads.pageInfo.hasNextPage' <<<"$page") == true ]] || break
      after=$(jq -r '.data.repository.pullRequest.reviewThreads.pageInfo.endCursor' <<<"$page")
    done
  } >"$out"
  echo "$out ($(grep -c '^## ' "$out") sections)"
}

cmd_close() {
  parse_pr "${1:?PR URL}"
  cmd_findings "$1"
  local base head
  read -r base head < <(gh pr view "$PR" -R "$REPO" --json baseRefName,headRefName --jq '"\(.baseRefName) \(.headRefName)"')
  [[ $base == review/*/base && $head == review/*/all ]] || die "not a cr-full-review PR ($base <- $head)"
  gh pr close "$PR" -R "$REPO" --comment "Findings collected; closing the review-only PR." >/dev/null
  for b in "$head" "$base"; do gh api -X DELETE "repos/$REPO/git/refs/heads/$b" >/dev/null; done
  echo "closed $REPO#$PR, deleted $base and $head"
}

case ${1:-} in
  open|wait|findings|close) c=$1; shift; "cmd_$c" "$@" ;;
  -h|--help|"") usage ;;
  *) die "unknown command $1 (open, wait, findings, close)" ;;
esac
